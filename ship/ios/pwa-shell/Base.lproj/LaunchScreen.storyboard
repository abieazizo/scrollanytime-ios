    <scenes>
        <!--THE LAUNCH, frame zero: the ground colour (#0B0B0F) and the unlit, closed scroll — a 112pt
            tile whose centre sits at 40% of the safe area's height, exactly where the web splash
            paints the same image before any JavaScript runs. The handoff from this screen to the
            web view is therefore one still image; the film begins from it. Launch screens cannot
            animate and this one does not need to. The spacer is the 40% measure.-->
        <scene sceneID="EHf-IW-A2E">
            <objects>
                <viewController id="01J-lp-oVM" sceneMemberID="viewController">
                    <view key="view" contentMode="scaleToFill" id="4mO-e4-REQ">
