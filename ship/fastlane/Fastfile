# Seder: the lanes the borrowed workflow (release-ios.yml) calls, in its order:
# signing, build, upload, screenshots, metadata. Seder is installed straight onto the owner's
# iPhone, so the last three have nothing to do.

default_platform(:ios)

ROOT = File.expand_path('../..', __dir__)

platform :ios do
  desc 'Put the signing certificate and the two profiles on this machine'
  lane :signing do |options|
    sh('bash', File.join(ROOT, 'ship', 'seder', 'signing.sh'))
  end

  desc 'Archive, signed, and pack the app'
  lane :build do |options|
    sh('bash', File.join(ROOT, 'ship', 'seder', 'build.sh'), (options[:build_number] || '1').to_s)
  end

  lane :upload do |options|
    UI.message('Seder is not uploaded to App Store Connect: the app file is the build artifact.')
  end

  lane :screenshots do
    UI.message('No store listing: nothing to push.')
  end

  lane :metadata do
    UI.message('No store listing: nothing to push.')
  end

  lane :submit do |options|
    UI.user_error!('Seder is never submitted for review.')
  end
end
